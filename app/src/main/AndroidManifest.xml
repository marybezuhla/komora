<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet only to read releases from GitHub; nothing about the phone or its owner is sent -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To install and update the apps in the catalog (Android asks the owner each time it must) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Updates to apps Komora installed go through without an extra tap -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Android 14+: another installer must ask the owner before updating apps Komora installed -->
    <uses-permission android:name="android.permission.ENFORCE_UPDATE_OWNERSHIP" />
    <!-- Optional update notices (off until turned on in Settings); Android asks the owner first -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- So the daily check, when turned on, continues after the phone restarts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 14+ requires it for a check that waits for a connection; no data, no prompt -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Removed even if a library asks for them -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />

    <!-- Komora sees the apps in its own catalog (must match assets/catalog.json; a unit test checks this)
         and, for sources the owner adds, apps that have a launcher icon: never services or system parts. -->
    <queries>
        <package android:name="ua.tarilka" />
        <package android:name="ua.mandat" />
        <package android:name="ua.sprotyv" />
        <package android:name="ua.pysanka" />
        <package android:name="ua.svitlyna" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Komora">

        <!-- Folding, unfolding, turning or resizing just redraws the screen (no restart, no flash).
             Language changes still restart it, as Android expects. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- No emoji font is fetched at start: Komora connects only to GitHub -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>

        <!-- The daily update check, only when turned on; only Android's job scheduler can start it -->
        <service
            android:name=".notify.UpdateJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- Only Android's installer reports here, through Komora's own PendingIntent -->
        <receiver
            android:name=".install.InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
